    {
      "id": "5b2f2283-1c0d-4b24-a2ec-cdbe6cebdacc",
      "name": "Check Document Version",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        390,
        180
      ],
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "with incoming as (\n  select $1::text as text, $2::text as source_key, $3::text as source,\n         $4::text as category, $5::text as file_type, $6::text as ingested_at\n), hashed as (\n  select incoming.*, encode(sha256(convert_to(incoming.text, 'UTF8')), 'hex') as content_hash,\n         gen_random_uuid()::text as version_id\n  from incoming\n)\nselect h.*, coalesce(r.content_hash = h.content_hash, false) as duplicate\nfrom hashed h left join public.document_registry r on r.source_key = h.source_key",
        "options": {
          "queryReplacement": "={{ [$json.text, $json.sourceKey, $json.source, $json.category, $json.fileType, $json.ingestedAt] }}"
        }
      }
    },
