    {
      "id": "12d7a905-2b35-429b-a8a3-0ba1704fdd4b",
      "name": "Confirm Duplicate",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        860,
        40
      ],
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "select $1::text as source, $2::text as category,\n  case when r.content_hash = $4::text then 'duplicate' else 'conflict_retry' end as status,\n  case when r.content_hash = $4::text then r.chunk_count else null end as active_chunks\nfrom (select 1) one\nleft join public.document_registry r on r.source_key = $3::text",
        "options": {
          "queryReplacement": "={{ [$json.source, $json.category, $json.source_key, $json.content_hash] }}"
        }
      }
    },
    {
      "id": "cfeae8aa-d33e-44c4-a435-4064a8717894",
      "name": "Count Indexed Chunks",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1170,
        310
      ],
      "parameters": {
        "jsCode": "// Supabase Vector Store emits one serialized document per prepared chunk,\n// after its insert call succeeds. One loop iteration contains one file.\nconst chunks = $input.all();\nif (!chunks.length) throw new Error('Vector store returned no chunks; activation cancelled.');\nconst first = chunks[0].json.metadata;\nif (!first?.source_key || !first?.content_hash || !first?.version_id) {\n  throw new Error('Indexed chunks are missing version metadata.');\n}\nfor (const chunk of chunks) {\n  const meta = chunk.json.metadata;\n  if (!meta || meta.source_key !== first.source_key ||\n      meta.content_hash !== first.content_hash || meta.version_id !== first.version_id ||\n      !String(chunk.json.pageContent || '').trim()) {\n    throw new Error('Inconsistent indexed chunk output; activation cancelled.');\n  }\n}\nreturn [{ json: { source: first.source, category: first.category,\n  source_key: first.source_key, content_hash: first.content_hash,\n  version_id: first.version_id, expected_chunks: chunks.length } }];"
      }
    },
    {
      "id": "26cd487d-d4f5-4efb-a6af-a2f5535b1382",
      "name": "Activate Document Version",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [
        1390,
        310
      ],
      "parameters": {
        "resource": "database",
        "operation": "executeQuery",
        "query": "select $1::text as source, $2::text as category, a.status, a.active_chunks\nfrom rag_private.activate_document($3::text, $4::text, $5::uuid, $6::integer) a",
        "options": {
          "queryReplacement": "={{ [$json.source, $json.category, $json.source_key, $json.content_hash, $json.version_id, $json.expected_chunks] }}"
        }
      }
    },
    {
      "id": "aa7705c0-bb13-4c63-a3a7-fc841358238e",
      "name": "Summarize Upload",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -300,
        -40
      ],
      "parameters": {
        "jsCode": "const files = $input.all().map(item => item.json);\nreturn [{ json: { files, inserted: files.filter(f => f.status === 'inserted').length,\n  replaced: files.filter(f => f.status === 'replaced').length,\n  duplicate: files.filter(f => f.status === 'duplicate').length,\n  conflict_retry: files.filter(f => f.status === 'conflict_retry').length } }];"
      }
    }
